# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU - CHỢ ĐỒ CŨ SINH VIÊN (chodocusinhvien)
# Sao chép file này thành `.env` (`cp .env.example .env`) trước khi chạy dự án.
# TUYỆT ĐỐI KHÔNG COMMIT FILE `.env` LÊN GIT!
# ==============================================================================

# --- Cấu hình Cơ sở dữ liệu PostgreSQL ---
POSTGRES_USER=chodocu_user
POSTGRES_PASSWORD=chodocu_secret_password_2026
POSTGRES_DB=chodocusinhvien_db
POSTGRES_PORT=5432

# Chuỗi kết nối SQLAlchemy (dùng host `db` khi chạy trong Docker Compose, hoặc `localhost` khi chạy local)
DATABASE_URL=postgresql://chodocu_user:chodocu_secret_password_2026@db:5432/chodocusinhvien_db

# --- Cấu hình Bảo mật & Xác thực JWT ---
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-chodocusinhvien-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Cấu hình Nghiệp vụ (Business Logic Rules) ---
# Giới hạn số tin đăng tối đa của 1 sinh viên trong 1 ngày
DAILY_LISTING_LIMIT=5

# --- Cấu hình Cổng & Frontend ---
APP_PORT=80
VITE_API_BASE_URL=/api/v1
