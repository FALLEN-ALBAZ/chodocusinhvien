    {
      "name": "5. Gửi đề nghị mua & Người bán chấp nhận (Chuyển sang Đã bán)",
      "description": "Sinh viên Mua hàng gửi đề nghị trả giá (`Offer`), sau đó Sinh viên Bán hàng chấp nhận (`ACCEPTED`) làm tin đăng tự động khóa sang trạng thái `SOLD`.",
      "item": [
        {
          "name": "5.1. Sinh viên Mua hàng gửi đề nghị mua / trả giá (POST /listings/{id}/offers)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tạo đề nghị mua thành công (201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const offer = pm.response.json();",
                  "pm.test('Trạng thái đề nghị mua là PENDING', function () {",
                  "    pm.expect(offer.status).to.eql('PENDING');",
                  "    pm.expect(offer.offered_price).to.eql(600000);",
                  "});",
                  "pm.collectionVariables.set('createdOfferId', offer.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentBuyerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offered_price\": 600000,\n  \"message\": \"Mình học Khoa Kinh tế, chiều nay mình qua sảnh thư viện lấy luôn với giá 600k bạn nhé!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/{{createdListingId}}/offers",
