      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Xác thực & Đăng nhập 3 Vai trò (Sinh viên Bán, Sinh viên Mua, Kiểm duyệt viên)",
      "description": "Kiểm tra sức khỏe hệ thống (`/api/v1/health`), đăng nhập 3 vai trò tác nhân chính trong kịch bản Demo ĐG2 và tự động lưu JWT Token vào biến Collection.",
      "item": [
        {
          "name": "1.1. Kiểm tra sức khỏe hệ thống (Health Check & X-Process-Time-Ms)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về mã 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Trạng thái dịch vụ là ok và có header X-Process-Time-Ms', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('ok');",
                  "    pm.response.to.have.header('X-Process-Time-Ms');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          }
        },
        {
          "name": "1.2. Đăng nhập Sinh viên Bán hàng (Nguyễn Văn An)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập Sinh viên Bán hàng thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Nhận JWT Access Token và đúng vai trò STUDENT', function () {",
                  "    pm.expect(res.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.user.role).to.eql('STUDENT');",
                  "});",
                  "pm.collectionVariables.set('studentSellerToken', res.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nguyenvana@sv.edu.vn\",\n  \"password\": \"Sv@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.3. Đăng nhập Sinh viên Mua hàng (Trần Thị Bình)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập Sinh viên Mua hàng thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Nhận JWT Access Token và đúng vai trò STUDENT', function () {",
                  "    pm.expect(res.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.user.role).to.eql('STUDENT');",
                  "});",
                  "pm.collectionVariables.set('studentBuyerToken', res.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tranthib@sv.edu.vn\",\n  \"password\": \"Sv@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.4. Đăng nhập Kiểm duyệt viên (Lê Hoàng Nam)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập Kiểm duyệt viên thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Nhận JWT Access Token và đúng vai trò MODERATOR', function () {",
                  "    pm.expect(res.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(res.user.role).to.eql('MODERATOR');",
                  "});",
                  "pm.collectionVariables.set('moderatorToken', res.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kiemduyet@sv.edu.vn\",\n  \"password\": \"Mod@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.5. Xem hồ sơ cá nhân đang đăng nhập (/api/v1/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về mã 200 OK và ẩn password_hash', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const user = pm.response.json();",
                  "    pm.expect(user.email).to.eql('nguyenvana@sv.edu.vn');",
                  "    pm.expect(user).to.not.have.property('password_hash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentSellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Danh mục & Đăng tin bán kèm nhiều ảnh",
      "description": "Lấy danh sách danh mục đồ cũ sinh viên và thực hiện đăng tin bán mới kèm nhiều hình ảnh minh họa (1:N). Tin mới đăng có trạng thái `PENDING` chờ duyệt.",
      "item": [
        {
          "name": "2.1. Lấy danh sách 6 danh mục đồ cũ sinh viên",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về mã 200 OK và danh sách >= 6 danh mục', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const categories = pm.response.json();",
                  "    pm.expect(categories.length).to.be.at.least(6);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"]
            }
          }
        },
        {
          "name": "2.2. Sinh viên Bán hàng đăng tin mới kèm 2 ảnh (Trạng thái khởi tạo PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng tin thành công trả về 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const listing = pm.response.json();",
                  "pm.test('Tin mới ở trạng thái PENDING và lưu đủ 2 ảnh minh họa', function () {",
                  "    pm.expect(listing.status).to.eql('PENDING');",
                  "    pm.expect(listing.images.length).to.eql(2);",
                  "});",
                  "pm.collectionVariables.set('createdListingId', listing.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentSellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tai nghe chụp tai Sony WH-CH520 Bluetooth pin 50 giờ học tiếng Anh\",\n  \"description\": \"Tai nghe chính hãng Sony mình mua để luyện nghe TOEIC, đệm tai êm không đau tai, pin cực trâu dùng cả tuần không cần sạc.\",\n  \"price\": 650000,\n  \"condition\": \"LIKE_NEW\",\n  \"category_id\": 2,\n  \"image_urls\": [\n    \"https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=800&q=80\",\n    \"https://images.unsplash.com/photo-1484704849700-f032a568e944?auto=format&fit=crop&w=800&q=80\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "listings"]
            }
          }
        },
        {
          "name": "2.3. Sinh viên Bán hàng xem danh sách tin đăng của tôi (/api/v1/listings/my)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về mã 200 OK và có chứa tin vừa đăng', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const items = pm.response.json();",
                  "    const createdId = Number(pm.collectionVariables.get('createdListingId'));",
                  "    pm.expect(items.some(i => i.id === createdId)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentSellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "listings", "my"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Kiểm duyệt viên duyệt tin & Chứng minh phân quyền (403 Forbidden)",
      "description": "Chứng minh cơ chế phân quyền RBAC: Sinh viên thường bị chặn `403 Forbidden` khi gọi API kiểm duyệt, sau đó Kiểm duyệt viên (`MODERATOR`) duyệt tin từ `PENDING` sang `APPROVED`.",
      "item": [
        {
          "name": "3.1. [RBAC 403] Sinh viên cố tình gọi API duyệt tin của Kiểm duyệt viên",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Hệ thống chặn truy cập trái phép với mã 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentSellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/moderation/listings/{{createdListingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "moderation", "listings", "{{createdListingId}}", "status"]
            }
          }
        },
        {
          "name": "3.2. Kiểm duyệt viên xem danh sách tin đang chờ duyệt (PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Kiểm duyệt viên lấy danh sách tin PENDING thành công (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const list = pm.response.json();",
                  "    pm.expect(list).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/moderation/listings?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "moderation", "listings"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "3.3. Kiểm duyệt viên phê duyệt tin đăng sang APPROVED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duyệt tin thành công (200 OK) và trạng thái chuyển sang APPROVED', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.status).to.eql('APPROVED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/moderation/listings/{{createdListingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "moderation", "listings", "{{createdListingId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Tìm kiếm, Lọc, Sắp xếp, Phân trang & Yêu thích (N:N)",
      "description": "Kiểm tra tìm kiếm đa tiêu chí, lọc khoảng giá, sắp xếp, phân trang và mối quan hệ Nhiều-Nhiều (`favorites` N:N).",
      "item": [
